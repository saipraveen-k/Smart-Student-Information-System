    {
      "name": "3. Academic Service",
      "item": [
        {
          "name": "Create Academic Record (POST)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"recordId\": \"AR020\",\n  \"studentId\": \"STU001\",\n  \"courseId\": \"C102\",\n  \"academicYear\": \"2024-2025\",\n  \"semester\": 6,\n  \"internalMarks\": 35.0,\n  \"externalMarks\": 55.0,\n  \"attendancePercentage\": 94.0,\n  \"remarks\": \"High distinction in DS\"\n}"
            },
            "url": { "raw": "{{gatewayUrl}}/api/academic-records", "host": ["{{gatewayUrl}}"], "path": ["api", "academic-records"] }
          }
        },
        {
          "name": "Get Student Performance (GET)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{gatewayUrl}}/api/academic-records/student/STU001/performance", "host": ["{{gatewayUrl}}"], "path": ["api", "academic-records", "student", "STU001", "performance"] }
          }
        }
      ]
    },
    {
      "name": "4. Reporting Service (SOAP)",
      "item": [
        {
          "name": "Get Student SOAP Report (POST /ws)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "text/xml;charset=UTF-8" }
            ],
            "body": {
              "mode": "raw",
              "raw": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<soapenv:Envelope xmlns:soapenv=\"http://schemas.xmlsoap.org/soap/envelope/\" xmlns:soap=\"http://ssis.com/reporting/soap\">\n   <soapenv:Header/>\n   <soapenv:Body>\n      <soap:getStudentReportRequest>\n         <soap:studentId>STU001</soap:studentId>\n      </soap:getStudentReportRequest>\n   </soapenv:Body>\n</soapenv:Envelope>"
            },
            "url": { "raw": "{{gatewayUrl}}/ws", "host": ["{{gatewayUrl}}"], "path": ["ws"] }
          }
        }
      ]
    },
    {
