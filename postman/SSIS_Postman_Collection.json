{
  "info": {
    "name": "Smart Student Information System (SSIS) API Collection",
    "description": "Complete Postman collection for REST APIs and SOAP Web Services in SSIS microservices architecture.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Student Service",
      "item": [
        {
          "name": "Create Student (POST)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"studentId\": \"STU015\",\n  \"firstName\": \"Arjun\",\n  \"lastName\": \"Kumar\",\n  \"email\": \"arjun.kumar@ssis.edu\",\n  \"phone\": \"+919876543299\",\n  \"dateOfBirth\": \"2003-04-12\",\n  \"gender\": \"MALE\",\n  \"department\": \"AIML\",\n  \"program\": \"B.Tech\",\n  \"year\": 3,\n  \"semester\": 6,\n  \"enrollmentDate\": \"2022-08-01\",\n  \"address\": \"Hyderabad, Telangana\",\n  \"status\": \"ACTIVE\"\n}"
            },
            "url": { "raw": "{{gatewayUrl}}/api/students", "host": ["{{gatewayUrl}}"], "path": ["api", "students"] }
          }
        },
        {
          "name": "Get All Students (GET)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{gatewayUrl}}/api/students", "host": ["{{gatewayUrl}}"], "path": ["api", "students"] }
          }
        },
        {
          "name": "Get Student By ID (GET)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{gatewayUrl}}/api/students/STU001", "host": ["{{gatewayUrl}}"], "path": ["api", "students", "STU001"] }
          }
        },
        {
          "name": "Search Students (GET)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{gatewayUrl}}/api/students/search?keyword=Sai", "host": ["{{gatewayUrl}}"], "path": ["api", "students", "search"], "query": [{ "key": "keyword", "value": "Sai" }] }
          }
        },
        {
          "name": "Update Student (PUT)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"studentId\": \"STU001\",\n  \"firstName\": \"Sai\",\n  \"lastName\": \"Praveen (Updated)\",\n  \"email\": \"sai.praveen@ssis.edu\",\n  \"phone\": \"+919876543210\",\n  \"dateOfBirth\": \"2003-05-14\",\n  \"gender\": \"MALE\",\n  \"department\": \"AIML\",\n  \"program\": \"B.Tech\",\n  \"year\": 3,\n  \"semester\": 6,\n  \"enrollmentDate\": \"2022-08-01\",\n  \"address\": \"Hyderabad, Telangana\",\n  \"status\": \"ACTIVE\"\n}"
            },
            "url": { "raw": "{{gatewayUrl}}/api/students/STU001", "host": ["{{gatewayUrl}}"], "path": ["api", "students", "STU001"] }
          }
        }
      ]
    },
